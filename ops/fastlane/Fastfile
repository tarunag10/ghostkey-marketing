default_platform(:ios)

RISKY_PHRASES = [
  "paywall bypass",
  "unlock paid content",
  "read without subscribing",
  "defeat login walls",
  "remove restrictions",
  "works everywhere",
  "guaranteed access"
].freeze

def metadata_root
  File.expand_path("metadata/en-US", __dir__)
end

def review_root
  File.expand_path("review_information", __dir__)
end

def require_env!(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable: #{name}") if value.to_s.strip.empty?
  value
end

def app_store_api_key
  app_store_connect_api_key(
    key_id: require_env!("ASC_API_KEY_ID"),
    issuer_id: require_env!("ASC_ISSUER_ID"),
    key_filepath: require_env!("ASC_API_KEY_PATH")
  )
end

def ensure_app_identifier!
  ENV["APP_IDENTIFIER"] = "com.tarunagarwal.ghostkey" if ENV["APP_IDENTIFIER"].to_s.strip.empty?
end

def validate_copy!
  files = Dir[File.join(metadata_root, "**", "*")] + Dir[File.join(review_root, "**", "*")]
  text = files.select { |path| File.file?(path) }.map { |path| File.read(path) }.join("\n").downcase

  RISKY_PHRASES.each do |phrase|
    UI.user_error!("Risky Apple-review phrase found: #{phrase}") if text.include?(phrase)
  end

  [
    "https://tarunag10.github.io/GhostKey/privacy-policy.html",
    "https://tarunag10.github.io/GhostKey/support.html",
    "com.tarunagarwal.ghostkey",
    "com.tarunagarwal.ghostkey.Extension"
  ].each do |required|
    UI.user_error!("Required review detail missing: #{required}") unless text.include?(required.downcase)
  end
end

platform :ios do
  private_lane :preflight_base do
    ensure_app_identifier!
    require_env!("ASC_API_KEY_ID")
    require_env!("ASC_ISSUER_ID")
    require_env!("ASC_API_KEY_PATH")
    validate_copy!
    UI.success("GhostKey App Store metadata preflight passed.")
  end

  lane :preflight do
    preflight_base
  end

  lane :metadata_only do
    preflight_base
    deliver(
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: "metadata",
      submission_information: {
        add_id_info_uses_idfa: false
      },
      force: true,
      submit_for_review: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  lane :submit_review do
    preflight_base
    require_env!("APP_REVIEW_CONTACT_EMAIL")
    require_env!("APP_REVIEW_CONTACT_PHONE")
    deliver(
      api_key: app_store_api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: "metadata",
      submission_information: {
        add_id_info_uses_idfa: false
      },
      force: true,
      submit_for_review: true,
      automatic_release: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  rescue => error
    UI.user_error!("GhostKey Apple resubmission failed: #{error.message}")
  end
end
